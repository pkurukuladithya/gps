{
  "expo": {
    "name": "KARP v1.0",
    "slug": "karp-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app_icon.jpg",
    "scheme": "karp",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/app_icon.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app_icon.jpg",
        "backgroundColor": "#0B3C5D"
      },
      "package": "com.karp.tracker",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "WAKE_LOCK",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/app_icon.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow KARP to stream telemetry and live tracking with high-accuracy GPS."
        }
      ]
    ]
  }
}
